{
  "name": "reward-desk-obs",
  "productName": "Reward Desk OBS",
  "version": "0.10.0",
  "private": true,
  "description": "Independent OBS Studio plugin for Twitch sound and video rewards",
  "author": "FermionaPlay",
  "license": "GPL-2.0-or-later",
  "main": "main.cjs",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/test-obs-editor.cjs",
    "build": "node tools/build-native.cjs && node tools/build.cjs",
    "installer": "node tools/build-installer.cjs",
    "build:native": "node tools/build-native.cjs",
    "build:runtime": "node tools/build.cjs",
    "test:obs": "node tools/test-obs-editor.cjs"
  },
  "dependencies": {
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/eventsub-ws": "8.2.0",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "electron": "42.11.8",
    "@electron/packager": "20.3.0",
    "playwright": "1.58.2"
  }
}
